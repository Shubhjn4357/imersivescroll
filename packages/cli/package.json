{
  "name": "@immersive-scroll/cli",
  "version": "0.1.2",
  "description": "CLI for immersive scroll frame extraction and validation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shubhjn4357/imersivescroll.git"
  },
  "homepage": "https://github.com/Shubhjn4357/imersivescroll#readme",
  "bugs": {
    "url": "https://github.com/Shubhjn4357/imersivescroll/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "immersive-scroll": "./bin/immersive-scroll.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@immersive-scroll/core": "workspace:^",
    "@immersive-scroll/shared": "workspace:^",
    "commander": "^14.0.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.34.5"
  }
}
