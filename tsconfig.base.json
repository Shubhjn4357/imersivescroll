{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@immersive-scroll/shared": ["./packages/shared/src/index.ts"],
      "@immersive-scroll/core": ["./packages/core/src/index.ts"],
      "@immersive-scroll/react": ["./packages/react/src/index.ts"],
      "@immersive-scroll/next": ["./packages/next/src/index.ts"],
      "@immersive-scroll/solid": ["./packages/solid/src/index.ts"],
      "@immersive-scroll/web": ["./packages/web/src/index.ts"]
    }
  }
}
